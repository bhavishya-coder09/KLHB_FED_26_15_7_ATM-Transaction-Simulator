    static void findPossibilities(int amount) {
        total = 0;
        for (int a = amount / 2000; a >= 0; a--) {
            int left1 = amount - a * 2000;
            for (int b = left1 / 500; b >= 0; b--) {
                int left2 = left1 - b * 500;
                for (int c = left2 / 200; c >= 0; c--) {
                    int d = (left2 - c * 200) / 100;
                    if (total < 5) {
                        first[total][0] = a;
                        first[total][1] = b;
                        first[total][2] = c;
                        first[total][3] = d;
                    }
                    total++;
                }
            }
        }
    }
