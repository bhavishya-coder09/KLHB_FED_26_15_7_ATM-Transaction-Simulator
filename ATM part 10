    static void choosePossibility(int amount, int show) {
        System.out.print("Choose a possibility (1-" + show + "): ");
        int pick = readInt();
        if (pick < 1 || pick > show) {
            System.out.println("Wrong choice, cancelled");
            return;
        }
        System.out.println("Collect your cash:");
        printNotes(first[pick - 1][0], first[pick - 1][1], first[pick - 1][2], first[pick - 1][3]);
        balance = balance - amount;
        withdrawnToday = withdrawnToday + amount;
        addHistory("Withdrawn Rs. " + amount);
        System.out.println("Remaining balance: Rs. " + balance);
    }
